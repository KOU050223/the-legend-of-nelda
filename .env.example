# LiveKit Cloud の WebSocket URL。API secret は絶対にここへ入れないこと。
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# ブラウザがNode WebSocket Authority serverへ接続するURL。開発時は server/index.ts の待受先を指定する。
VITE_AUTHORITY_WS_URL=ws://localhost:3000

# 本番/発表用: 同一Cloudflare WorkerのToken Endpoint。
# POSTで { roomName, playerId, role } を受け、{ token, url } を返す。
# LiveKit API Secret はWorker Secretにだけ置く。
VITE_LIVEKIT_TOKEN_ENDPOINT=/api/livekit/token

# Voiceの既定Room名。複数Room化時はAuthorityがsession IDを配信し、クライアント設定より優先する。
VITE_LIVEKIT_ROOM_NAME=nelda-demo

# 開発専用: LiveKit Cloud Settings で Development Token Server を有効化して取得するID。
# VITE_LIVEKIT_DEVELOPMENT_TOKEN_SERVER_ID=token-server-...

# Node WebSocket Authority server (server/index.ts) の共有room参加用トークン。
# 任意設定。未設定なら共有URLの `?token=` がroom IDになり、値ごとに独立した
# 3人用Battle Roomを作る。例: `?token=team-a` と `?token=team-b` は混ざらない。
# 設定時はそのtokenだけを受理する単一room運用になる。
# VITE_ prefixを付けない(ブラウザバンドルへ絶対に含めない)。
# NELDA_ROOM_TOKEN=change-me-shared-room
