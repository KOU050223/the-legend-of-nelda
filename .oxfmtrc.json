{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "endOfLine": "lf",
  "ignorePatterns": [
    "dist",
    "node_modules",
    "coverage",
    ".direnv",
    "pnpm-lock.yaml",
    "flake.lock",
    "docs/**"
  ]
}
