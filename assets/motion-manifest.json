  "$comment": "モデルごとのモーション定義。Pythonのビルドスクリプトと表示層(TS)が同じこのファイルを読む。片方だけ更新してズレるのを防ぐため、定義はここ1本にまとめる。詳細は docs/motion-manifest.md。",
  "models": {
    "hori-daisuke": {
      "label": "堀大輔 (ボス)",
      "url": "/models/hori-daisuke.glb",
      "standingHeight": 0.762,
      "rig": "mixamo",
      "build": {
        "script": "scripts/build-hori-daisuke-glb.py",
        "baseClip": "stand-up",
        "sources": {
          "walking.fbx": "walk",
          "Sleeping Idle.fbx": "sleep",
          "Warrior Idle.fbx": "idle",
          "Sprinting Forward Roll.fbx": "roll",
          "Punch Combo.fbx": "punch"
        },
        "motionDir": "assets/motions"
      },
      "clips": {
        "stand-up": {
          "loop": false,
          "label": "起き上がり"
        },
        "walk": {
          "loop": true,
          "label": "歩行"
        },
        "idle": {
          "loop": true,
          "label": "待機"
        },
        "roll": {
          "loop": false,
          "label": "回避"
        },
        "punch": {
          "loop": false,
          "label": "攻撃"
        },
        "sleep": {
          "loop": true,
          "label": "sleep"
        }
      },
      "defaultClip": "idle",
      "rules": [
        { "when": "attacking", "clip": "punch" },
        { "when": "dodging", "clip": "roll" },
        { "when": "fallingAsleep", "clip": "sleep" },
        { "when": "asleep", "clip": "sleep" },
        { "when": "moving", "clip": "walk" }
      ]
    },
